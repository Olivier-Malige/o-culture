<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
        <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.2.0/css/all.css" integrity="sha384-hWVjflwFxL6sNzntih27bfxkr27PmbbK/iSvJ+a4+0owXq79v+lsFkW54bOGbiDQ" crossorigin="anonymous">
        <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.1.3/css/bootstrap.min.css" integrity="sha384-MCw98/SFnGE8fJT3GXwEOngsV7Zt27NXFoaoApmYm81iuXoPkFOJwJ8ERdknLPMO" crossorigin="anonymous">
        <link rel="stylesheet" href="{{ asset('css/style.css') }}" >
        <link href="https://stackpath.bootstrapcdn.com/bootswatch/4.1.3/flatly/bootstrap.min.css" rel="stylesheet" integrity="sha384-gJWVjz180MvwCrGGkC4xE5FjhWkTxHIR/+GgT8j2B3KKMgh6waEjPgzzh7lL7JZT" crossorigin="anonymous">    </head>
    <body>
        <header>
            <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
                {% if is_granted('ROLE_ARTIST')or is_granted('ROLE_ORGANIZER')or is_granted('IS_AUTHENTICATED_ANONYMOUSLY') %}
                    <a class="navbar-brand" href="#">O'Culture</a>
                {% else %}
                    <a class="navbar-brand" href="#">Admin - O'Culture</a>
                {% endif %}
                <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarColor01" aria-controls="navbarColor01" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarColor01">
                    <ul class="navbar-nav mr-auto">
                        {% if is_granted('ROLE_ADMINISTRATOR') %}
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_user_index', {'page': 1}) }}"><i class="fas fa-user"></i> Utilisateurs</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('event_index', {'page': 1}) }}"><i class="far fa-calendar"></i>  Événements</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('place_index', {'page': 1}) }}"><i class="fas fa-map-marked-alt"></i> Lieux</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('comment_index', {'page': 1}) }}"><i class="fas fa-comments"></i> Commentaires</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('role_index') }}"><i class="fas fa-sliders-h"></i> Rôles</a>
                        </li>
                        {% endif %}
                        {% if is_granted('ROLE_ARTIST')or is_granted('ROLE_ORGANIZER')or is_granted('ROLE_ADMINISTRATOR') %}
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('message_index') }}"><i class="fas fa-envelope"></i> Messagerie</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('admin_logout') }}"><i class="fas fa-sign-out-alt"></i> Déconnexion</a>
                        </li>
                        {% endif %}
                    </ul>
                </div>
            </nav>
        </header>
        <main>
            {% block body %}{% endblock %}
        </main>
        {% block javascripts %}{% endblock %}
    </body>
</html>

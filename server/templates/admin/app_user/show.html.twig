{% extends 'base.html.twig' %}

{% block title %}{{ app_user.username }}{% endblock %}

{% block body %}
    <h1>{{ app_user.username }}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Pseudo</th>
                <td>{{ app_user.username }}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ app_user.email }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ app_user.name }}</td>
            </tr>
            <tr>
                <th>Image</th>
                <td>{{ app_user.image }}</td>
            </tr>
            <tr>
                <th>Ville</th>
                <td>{{ app_user.city }}</td>
            </tr>
            <tr>
                <th>Rôle</th>
                <td>{{ app_user.role.name }}</td>
            </tr>
            {% if app_user.role == 'Artiste' %}
            <tr>
                <th>Type d'artiste</th>
                {% for artist_type in app_user.AppUserArtistType %}
                <td>{{ artist_type.name }}</td>
                {% endfor %}
            </tr>
            {% endif %}
            {% if app_user.role.name == 'Artiste' or app_user.role == 'Organisateur' %}
            <tr>
                <th>Description</th>
                <td>{{ app_user.description }}</td>
            </tr>
            <tr>
                <th>Facebook</th>
                <td>{{ app_user.facebook }}</td>
            </tr>
            <tr>
                <th>Twitter</th>
                <td>{{ app_user.twitter }}</td>
            </tr>
            <tr>
                <th>Website</th>
                <td>{{ app_user.website }}</td>
            </tr>
            {% endif %}
            <tr>
                <th>IsActive</th>
                <td>{{ app_user.isActive ? 'Yes' : 'No' }}</td>                
            </tr>
            <tr>
                <th>Status</th>
                <td>{{ app_user.status }}</td>
            </tr>
            <tr>
                <th>Créé le</th>
                <td>{{ app_user.createdAt ? app_user.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>


    <div class="d-flex mt-4">
        <a href="{{ path('app_user_index', {page: 1}) }}" class="btn btn-dark mr-1">Retour à la liste des utilisateurs</a>
        <a href="{{ path('app_user_edit', {'id': app_user.id}) }}" class="btn btn-primary mr-1">Modifier</a>
        {{ include('admin/app_user/_delete_form.html.twig') }}
    </div>

{% endblock %}
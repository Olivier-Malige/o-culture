{% extends 'base.html.twig' %}

{% block title %}Liste des lieux{% endblock %}

{% block body %}
    <h1>Liste des lieux</h1>
    {{ include('admin/partials/navplace.html.twig') }}
    {% for message in app.flashes('notice') %}
    <div class="alert alert-dismissible alert-info">
    {{ message }}
    </div>
    {% endfor %}
    <table class="table table-hover">
        <thead>
            <tr class="table-primary">
                <th>Nom</th>
                <th>Email</th>
                <th>Créateur</th>
                <th>Créé le</th>
                <th>Actif</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for place in places %}
            <tr>
                <td>{{ place.name }}</td>
                <td>{{ place.email }}</td>
                <td><a href="{{ path('app_user_show', {'id': place.AppUserCreator.id}) }}"> {{ place.AppUserCreator.name }}</a></td>
                <td>{{ place.createdAt ? place.createdAt|date('d-m-Y à H:i') : '' }}</td>
                <td>{{ place.isActive ? 'Oui' : 'Non' }}</td>
                <td>
                    <a href="{{ path('place_show', {'id': place.id}) }}" class="btn btn-dark mr-1">Détails</a>
                    <a href="{{ path('place_edit', {'id': place.id}) }}" class="btn btn-primary mr-1">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="15">Aucune donnée trouvée</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    {% if maxPages is defined and maxPages > 1  %}
    <ul class="pagination">
        <li {{ thisPage == 1 ? 'class="disabled"' }} class="page-item">
            <a class="page-link" href="{{ path('place_index', {page: thisPage-1 < 1 ? 1 : thisPage-1}) }}"><i class="fas fa-arrow-left"></i></a>
        </li>
        {% for i in 1..maxPages %}
        <li {{ thisPage == i ? 'class="active"' }} class="page-item">
            <a class="page-link" href="{{ path('place_index', {page: i}) }}">{{ i }}</a>
        </li>
        {% endfor %}
        <li {{ thisPage == maxPages ? 'class="disabled"' }} class="page-item">
            <a class="page-link" href="{{ path('place_index', {page: thisPage+1 <= maxPages ? thisPage+1 : thisPage}) }}"><i class="fas fa-arrow-right"></i></a>
        </li>
    </ul>
    {% endif %}
{% endblock %}
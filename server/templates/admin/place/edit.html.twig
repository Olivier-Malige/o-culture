{% extends 'base.html.twig' %}

{% block title %}Modifier le lieu - {{ place.name }}{% endblock %}

{% block body %}
    <h1>Modifier le lieu - {{ place.name }}</h1>

    {{ include('admin/place/_form.html.twig', {'button_label': 'Sauvegarder'}) }}

    <div class="d-flex mt-4">
        <a href="{{ path('place_index', {page: 1}) }}" class="btn btn--dark mr-1">Retour à la liste des lieux</a>
        {{ include('admin/place/_delete_form.html.twig') }}
    </div>

{% endblock %}
{% extends 'base.html.twig' %}

{% block title %}Lieu{% endblock %}

{% block body %}
    <h1>Lieu -{{ place.name }}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Nom</th>
                <td>{{ place.name }}</td>
            </tr>
            <tr>
                <th>Siret</th>
                <td>{{ place.siret }}</td>
            </tr>
            <tr>
                <th>Créateur</th>
                <td><a href="{{ path('app_user_show', {'id': place.AppUserCreator.id}) }}">{{ place.AppUserCreator.name }}</a></td>
            </tr>
            <tr>
                <th>Adresse</th>
                <td>{{ place.adress }}</td>
            </tr>
            <tr>
                <th>Code postal</th>
                <td>{{ place.zipcode }}</td>
            </tr>
            <tr>
                <th>Ville</th>
                <td>{{ place.city }}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ place.email }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ place.description }}</td>
            </tr>
            <tr>
                <th>Website</th>
                <td>{{ place.website }}</td>
            </tr>
            <tr>
                <th>Facebook</th>
                <td>{{ place.facebook }}</td>
            </tr>
            <tr>
                <th>Image</th>
                <td>{{ place.image }}</td>
            </tr>
            <tr>
                <th>Actif</th>
                <td>{{ place.isActive ? 'Oui' : 'Non' }}</td>
            </tr>
            <tr>
                <th>Status</th>
                <td>{{ place.status }}</td>
            </tr>
            <tr>
                <th>Créé le</th>
                <td>{{ place.createdAt ? place.createdAt|date('d-m-Y à H:i') : '' }}</td>
            </tr>
        </tbody>
    </table>
    <div class="d-flex">
        <a href="{{ path('place_index', {page: 1}) }}" class="btn btn-dark mr-1">Retour à la liste des lieux</a>
        <a href="{{ path('place_edit', {'id': place.id}) }}" class="btn btn-primary mr-1">Modifier</a>
        {{ include('admin/place/_delete_form.html.twig') }}
    </div>
{% endblock %}
{% extends 'base.html.twig' %}

{% block title %}Liste des types d'événements{% endblock %}

{% block body %}
    <h1>Liste des types d'événements</h1>
    {{ include('admin/partials/navevent.html.twig') }}
    <a href="{{ path('event_type_new') }}" class="btn btn-success mr-1 mb-4">Ajouter un nouveau type d'événements</a>
    {% for message in app.flashes('notice') %}
    <div class="alert alert-dismissible alert-info">
    {{ message }}
    </div>
    {% endfor %}
    <table class="table table-hover">
        <thead>
            <tr class="table-primary">
                <th>Nom</th>
                <th>Créé le</th>
                <th>Actif</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for event_type in event_types %}
            <tr>
                <td>{{ event_type.name }}</td>
                <td>{{ event_type.createdAt ? event_type.createdAt|date('d-m-Y à H:i') : '' }}</td>
                <td>{{ event_type.isActive ? 'Oui' : 'Non'  }}</td>
                <td>
                    <a href="{{ path('event_type_show', {'id': event_type.id}) }}" class="btn btn-dark mr-1">Détails</a>
                    <a href="{{ path('event_type_edit', {'id': event_type.id}) }}" class="btn btn-primary mr-1">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">Aucune donnée enregistrée</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    {% if maxPages is defined and maxPages > 1  %}
    <ul class="pagination">
        <li {{ thisPage == 1 ? 'class="disabled"' }} class="page-item">
            <a class="page-link" href="{{ path('event_type_index', {page: thisPage-1 < 1 ? 1 : thisPage-1}) }}"><i class="fas fa-arrow-left"></i></a>
        </li>
        {% for i in 1..maxPages %}
        <li {{ thisPage == i ? 'class="active"' }} class="page-item">
            <a class="page-link" href="{{ path('event_type_index', {page: i}) }}">{{ i }}</a>
        </li>
        {% endfor %}
        <li {{ thisPage == maxPages ? 'class="disabled"' }} class="page-item">
            <a class="page-link" href="{{ path('event_type_index', {page: thisPage+1 <= maxPages ? thisPage+1 : thisPage}) }}"><i class="fas fa-arrow-right"></i></a>
        </li>
    </ul>
    {% endif %}
{% endblock %}
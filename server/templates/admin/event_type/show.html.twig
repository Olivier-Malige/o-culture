{% extends 'base.html.twig' %}

{% block title %}Type d'événement{% endblock %}

{% block body %}
    <h1>Type d'événement</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Nom</th>
                <td>{{ event_type.name }}</td>
            </tr>
            <tr>
                <th>Actif</th>
                <td>{{ event_type.isActive ? 'Oui' : 'Non' }}</td>
            </tr>
            <tr>
                <th>Créé le</th>
                <td>{{ event_type.createdAt ? event_type.createdAt|date('d-m-Y à H:i') : '' }}</td>
            </tr>
        </tbody>
    </table>
    <div class="d-flex">
        <a href="{{ path('event_type_index', {page: 1}) }}" class="btn btn-dark mr-1">Retour à la liste des types d'événements</a>
        <a href="{{ path('event_type_edit', {'id': event_type.id}) }}" class="btn btn-primary mr-1">Modifier</a>
        {{ include('admin/event_type/_delete_form.html.twig') }}
    </div>

{% endblock %}
{% extends 'base.html.twig' %}

{% block title %}{{ event.name }}{% endblock %}

{% block body %}
    <h1>{{ event.name }}</h1>

    <table class="table table-hover">
        <tbody>
            <tr>
                <th>Nom</th>
                <td>{{ event.name }}</td>
            </tr>
            <tr>
                <th>Date</th>
                <td>{{ event.plannedDate ? event.plannedDate|date('d-m-Y à H:i') : '' }}</td>
            </tr>
            <tr>
                <th>Lieu</th>
                <td>{{ event.eventPlace.name }}, {{ event.eventPlace.adress }}, {{ event.eventPlace.zipcode }} {{ event.eventPlace.city }} </td>
            </tr>
            <tr>
                <th>Créateur de l'événement</th>
                <td>{{ event.appUserCreator.name }} </td>
            </tr>
            <tr>
                <th>Type d'événément</th>
                <td>{{ event.eventType.name }}</td>
            </tr>
            <tr>
                <th>Tags de l'événément</th>
                {% for tag in event.EventTags %}
                <td>{{ tag.name }}</td>
                {% endfor %}
            </tr>
            <tr>
                <th>Nombre de spectateurs</th>
                <td>{{ event.nbSpectator }}</td>
            </tr>
            <tr>
                <th>Prix</th>
                <td>{{ event.price }} €</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ event.description }}</td>
            </tr>
            <tr>
                <th>Image</th>
                <td>{{ event.image }}</td>
            </tr>
            <tr>
                <th>Status</th>
                <td>{{ event.status }}</td>
            </tr>
            <tr>
                <th>Créé le</th>
                <td>{{ event.createdAt ? event.createdAt|date('d-m-Y à H:i') : '' }}</td>
            </tr>
            <tr>
                <th>Actif</th>
                <td>{{ event.isActive ? 'Oui' : 'Non' }}</td>
            </tr>
        </tbody>
    </table>
    <div class="d-flex">
        <a href="{{ path('event_index', {page: 1}) }}" class="btn btn-dark mr-1">Retour à la liste des événements</a>
        <a href="{{ path('event_edit', {'id': event.id}) }}" class="btn btn-primary mr-1">Modifier</a>
        {{ include('admin/event/_delete_form.html.twig') }}
    </div>
{% endblock %}
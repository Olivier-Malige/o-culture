{% extends 'base.html.twig' %}

{% block title %}Liste des types de lieux{% endblock %}

{% block body %}
    <h1>Liste des types de lieux</h1>
    {% for message in app.flashes('notice') %}
    <div class="alert alert-dismissible alert-info">
    {{ message }}
    </div>
    {% endfor %}
    
    {{ include('admin/partials/navplace.html.twig') }}
    <a href="{{ path('place_type_new') }}" class="btn btn-success mr-1 mb-3">Ajouter un nouveau type de lieu</a>

    <table class="table table-hover">
        <thead>
            <tr class="table-primary">
                <th>Nom</th>
                <th>Actif</th>
                <th>Crée le</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for place_type in place_types %}
            <tr>
                <td>{{ place_type.name }}</td>
                <td>{{ place_type.isActive ? 'Oui' : 'Non' }}</td>
                <td>{{ place_type.createdAt ? place_type.createdAt|date('d-m-Y à H:i') : '' }}</td>
                <td>
                    <a href="{{ path('place_type_show', {'id': place_type.id}) }}" class="btn btn-dark mr-1">Détails</a>
                    <a href="{{ path('place_type_edit', {'id': place_type.id}) }}" class="btn btn-primary mr-1">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">Aucune donnée trouvée</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    {% if maxPages is defined and maxPages > 1  %}
    <ul class="pagination">
        <li {{ thisPage == 1 ? 'class="disabled"' }} class="page-item">
            <a class="page-link" href="{{ path('place_type_index', {page: thisPage-1 < 1 ? 1 : thisPage-1}) }}"><i class="fas fa-arrow-left"></i></a>
        </li>
        {% for i in 1..maxPages %}
        <li {{ thisPage == i ? 'class="active"' }} class="page-item">
            <a class="page-link" href="{{ path('place_type_index', {page: i}) }}">{{ i }}</a>
        </li>
        {% endfor %}
        <li {{ thisPage == maxPages ? 'class="disabled"' }} class="page-item">
            <a class="page-link" href="{{ path('place_type_index', {page: thisPage+1 <= maxPages ? thisPage+1 : thisPage}) }}"><i class="fas fa-arrow-right"></i></a>
        </li>
    </ul>
    {% endif %}
{% endblock %}
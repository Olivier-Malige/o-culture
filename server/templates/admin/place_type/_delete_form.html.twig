<form method="post" action="{{ path('place_type_delete', {'id': place_type.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_method" value="DELETE">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ place_type.id) }}">
    <button class="btn btn-danger mr-1">Supprimer</button>
</form>
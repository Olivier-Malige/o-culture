{% extends 'base.html.twig' %}

{% block title %}Type de lieu - {{ place_type.name }}{% endblock %}

{% block body %}
    <h1>Type de lieu - {{ place_type.name }}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Nom</th>
                <td>{{ place_type.name }}</td>
            </tr>
            <tr>
                <th>Actif</th>
                <td>{{ place_type.isActive ? 'Oui' : 'Non' }}</td>
            </tr>
            <tr>
                <th>Créé le</th>
                <td>{{ place_type.createdAt ? place_type.createdAt|date('d-m-Y à H:i') : '' }}</td>
            </tr>
        </tbody>
    </table>
    
    <div class="d-flex">
        <a href="{{ path('place_type_index', {page: 1}) }}" class="btn btn-dark mr-1">Retour à la liste des lieux</a>
        <a href="{{ path('place_type_edit', {'id': place_type.id}) }}" class="btn btn-primary mr-1">Modifier</a>
        {{ include('admin/place_type/_delete_form.html.twig') }}
    </div>

{% endblock %}
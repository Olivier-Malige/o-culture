{% extends 'base.html.twig' %}

{% block title %}Tag {{ tag.name }}{% endblock %}

{% block body %}
    <h1>Tag - {{ tag.name }}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Nom</th>
                <td>{{ tag.name }}</td>
            </tr>
            <tr>
                <th>Actif</th>
                <td>{{ tag.isActive ? 'Oui' : 'Non' }}</td>
            </tr>
            <tr>
                <th>Créé le</th>
                <td>{{ tag.createdAt ? tag.createdAt|date('d-m-Y à H:i') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <div class="d-flex">
        <a href="{{ path('tag_index', {page: 1}) }}" class="btn btn-dark mr-1">Retour à la liste des tags</a>
        <a href="{{ path('tag_edit', {'id': tag.id}) }}" class="btn btn-primary mr-1">Modifier</a>
        {{ include('admin/tag/_delete_form.html.twig') }}
    </div>
{% endblock %}
{% extends 'base.html.twig' %}

{% block title %}Commentaire{% endblock %}

{% block body %}
    <h1>Commentaire</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Contenu</th>
                <td>{{ comment.content }}</td>
            </tr>
            <tr>
                <th>Auteur</th>
                <td>{{ comment.AppUser.name }}</td>
            </tr>
            <tr>
                <th>Créé le</th>
                <td>{{ comment.createdAt ? comment.createdAt|date('d-m-Y à H:i') : '' }}</td>
            </tr>
            <tr>
                <th>Actif</th>
                <td>{{ comment.isActive ? 'Oui' : 'Non' }}</td>
            </tr>
            <tr>
                <th>Nombres de likes</th>
                <td>{{ comment.nbLikes }}</td>
            </tr>
            <tr>
                <th>Nombre de signalements</th>
                <td> {{ comment.nbAlert }} </td>
            </tr>
            <tr>
                <th>Status</th>
                <td>{{ comment.status }}</td>
            </tr>
        </tbody>
    </table>

    <div class="d-flex mt-4">
        <a href="{{ path('comment_index', {page: 1}) }}" class="btn btn-dark mr-1">Retour à la liste des commentaires</a>
        <a href="{{ path('comment_edit', {'id': comment.id}) }}" class="btn btn-primary mr-1">Modifier</a>
        {{ include('admin/comment/_delete_form.html.twig') }}
    </div>
{% endblock %}
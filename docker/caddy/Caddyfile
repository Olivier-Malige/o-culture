{
	email {$ACME_EMAIL}
}

{$SITE_ADDRESS} {
	encode gzip

	handle /api* {
		reverse_proxy api:80 {
			header_up Authorization {http.request.header.Authorization}
		}
	}

	handle /admin* {
		reverse_proxy api:80
	}

	handle /chat* {
		reverse_proxy api:80
	}

	handle /css* {
		reverse_proxy api:80
	}

	handle /bundles* {
		reverse_proxy api:80
	}

	@static path *.css *.js *.jpg *.jpeg *.png *.svg *.ico *.woff *.woff2
	handle @static {
		root * /srv
		file_server
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
